// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum DesignType {
  INTERIOR
  EXTERIOR
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
}

enum ProjectCategory {
  KITCHEN
  LIVING_ROOM
  BEDROOM
  FULL_HOME
  VILLA
  OFFICE
  BUILDING_EXTERIOR
  FACADE_ELEVATION
  BALCONY_TERRACE
  OUTDOOR_SPACE
  RENOVATION
  OTHER
}

enum LeadSource {
  QUOTE_CALCULATOR
  CONTACT_FORM
  WHATSAPP_CLICK
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum CertificationType {
  COURSE
  MEMBERSHIP
  REGISTRATION
}

enum PricingTier {
  BUDGET
  STANDARD
  PREMIUM
  LUXURY
}

// ---------- Core content ----------

model Project {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  designType     DesignType
  propertyType   PropertyType
  category       ProjectCategory
  location       String // locality only, e.g. "Majiwada, Thane"
  description    String          @db.Text
  servicesUsed   String[] // free-text tags shown on project detail
  carpetAreaSqFt Int?
  completionYear Int?
  isFeatured     Boolean         @default(false)
  isPublished    Boolean         @default(true)
  sortOrder      Int             @default(0)
  images         ProjectImage[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([designType, category])
  @@index([isFeatured, isPublished])
}

model ProjectImage {
  id                String    @id @default(cuid())
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  cloudinaryId      String // public_id for transformations
  url               String
  mediaType         MediaType @default(IMAGE)
  thumbnailUrl      String?
  thumbnailPublicId String?
  altText           String // required at input level for accessibility + SEO
  sortOrder         Int       @default(0)
  isCoverImage      Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([projectId])
}

model Service {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  designType  DesignType
  description String     @db.Text
  iconKey     String? // maps to a predefined icon set, not free-text SVG
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Testimonial {
  id                String   @id @default(cuid())
  clientName        String
  clientRole        String? // e.g. "Homeowner, Bhandup" — first name + locality only, per privacy norms
  quote             String   @db.Text
  imageUrl          String?
  imagePublicId     String?
  imageUrls         String[] @default([])
  imagePublicIds    String[] @default([])
  videoUrl          String?
  videoPublicId     String?
  videoUrls         String[] @default([])
  videoPublicIds    String[] @default([])
  thumbnailUrl      String?
  thumbnailPublicId String?
  thumbnailUrls     String[] @default([])
  thumbnailPublicIds String[] @default([])
  slug              String?  @unique
  location          String?
  projectType       String?
  rating            Int      @default(5)
  isPublished       Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
}

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certification {
  id                    String            @id @default(cuid())
  title                 String
  issuingBody           String
  certificateType       CertificationType
  issueDate             DateTime?
  validUntil            DateTime?
  badgeLabel            String
  imageUrl              String?
  imagePublicId         String?
  certificateUrl        String?
  showCertificateButton Boolean           @default(false)
  isPublished           Boolean           @default(true)
  sortOrder             Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

// ---------- Quote calculator (admin-configurable pricing) ----------

// A PricingOption is a selectable item in the calculator
// (e.g. "3 BHK", "Modular Kitchen - Premium", "Extra Bathroom").
model PricingOption {
  id            String      @id @default(cuid())
  groupKey      String // "bhk_type" | "kitchen" | "hall" | "bedroom" | "bathroom"
  // | "interior_package" | "exterior_service" | "material_tier" | "addon"
  label         String // "3 BHK", "Premium Laminate", etc.
  designType    DesignType?
  basePrice     Decimal     @db.Decimal(10, 2)
  perUnitPrice  Decimal?    @db.Decimal(10, 2) // for quantity-based items (e.g. per bedroom)
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  effectiveFrom DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  bhkRoomDefaults BhkRoomDefault[] @relation("bhkOption")

  @@index([groupKey, isActive])
}

model BhkRoomDefault {
  id           String        @id @default(cuid())
  bhkOptionId  String
  bhkOption    PricingOption @relation("bhkOption", fields: [bhkOptionId], references: [id], onDelete: Cascade)
  roomGroupKey String // "kitchen" | "hall" | "bedroom" | "bathroom"
  defaultQty   Int
  minQty       Int
  maxQty       Int?
  isFixedFloor Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([bhkOptionId, roomGroupKey])
  @@index([bhkOptionId])
}

model ComponentPricing {
  id           String      @id @default(cuid())
  componentKey String
  tier         PricingTier
  pricePerUnit Decimal     @db.Decimal(10, 2)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([componentKey, tier])
}

model Lead {
  id                  String     @id @default(cuid())
  name                String
  phone               String
  email               String?
  location            String?
  requirements        String?    @db.Text
  source              LeadSource
  selections          Json? // snapshot of quote calculator selections at submission time
  estimatedBudget     Int?
  estimatedBudgetLow  Int?
  estimatedBudgetHigh Int?
  status              LeadStatus @default(NEW)
  notes               String?    @db.Text // internal admin notes
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([status])
  @@index([source])
}

// ---------- Admin & settings ----------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// Singleton row — enforced at the application layer (always id = "singleton")
model SiteSettings {
  id                    String   @id @default("singleton")
  companyName           String   @default("REALSPACE")
  phone                 String
  whatsapp              String
  email                 String
  address               String
  socialLinks           Json? // { instagram, facebook, youtube }
  heroHeadline          String
  heroSubhead           String
  ctaText               String
  ownerPortraitUrl      String?
  ownerPortraitPublicId String?
  showOwnerPortrait     Boolean? @default(true)
  logoUrl               String?
  logoPublicId          String?
  faviconUrl            String?
  faviconPublicId       String?
  footerContent         String?
  copyrightText         String?
  headerCtaText         String?
  headerCtaUrl          String?
  navigationJson        String?
  updatedAt             DateTime @updatedAt
}

// Canonical website-content models mapped to the existing legacy tables.
// No additional tables are created by this mapping.
model WebsitePage {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  description          String?
  isPublished          Boolean              @default(true)
  sortOrder            Int                  @default(0)
  publishedContentJson String?
  updatedAt            DateTime             @updatedAt
  createdAt            DateTime             @default(now())
  sections             WebsitePageSection[]

  @@map("ArnavPage")
}

model WebsitePageSection {
  id            String      @id @default(cuid())
  pageId        String
  page          WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sectionKey    String
  heading       String?
  body          String?
  imageUrl      String?
  imagePublicId String?
  imageAlt      String?
  mediaAssetId  String?
  buttonLabel   String?
  buttonUrl     String?
  isEnabled     Boolean     @default(true)
  sortOrder     Int         @default(0)
  updatedAt     DateTime    @updatedAt

  @@unique([pageId, sectionKey])
  @@index([pageId, sortOrder])
  @@map("ArnavPageSection")
}

model MediaAsset {
  id            String   @id @default(cuid())
  url           String
  cloudinaryId  String?
  altText       String   @default("")
  sortOrder     Int      @default(0)
  category      String   @default("general")
  format        String?
  width         Int?
  height        Int?
  fileSizeBytes Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category, sortOrder])
  @@map("ArnavMedia")
}

// ---------- OTP & Verification ----------

model EmailOtp {
  id            String   @id @default(cuid())
  email         String
  otpHash       String
  expiresAt     DateTime
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  verified      Boolean  @default(false)
  verifiedToken String?  @unique
  used          Boolean  @default(false)
  lastSentAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([email])
}

// ---------- Offers ----------

model Offer {
  id            String    @id @default(cuid())
  title         String?
  description   String?   @db.Text
  imageUrl      String?
  imagePublicId String?
  ctaLabel      String
  ctaLink       String
  isActive      Boolean   @default(true)
  showOnHome    Boolean?  @default(false)
  startDate     DateTime?
  endDate       DateTime?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- Gallery ----------

model GalleryCategory {
  id        String         @id @default(cuid())
  name      String         @unique
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  images    GalleryImage[]
}

model GalleryImage {
  id                String          @id @default(cuid())
  title             String
  categoryId        String
  category          GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  designType        DesignType
  mediaType         MediaType       @default(IMAGE)
  cloudinaryId      String
  url               String
  fileSizeBytes     Int?
  cloudinaryEtag    String?
  theme             String?
  approxBudgetLabel String?
  description       String?         @db.Text
  isCategoryCover   Boolean         @default(false)
  isFeatured        Boolean         @default(false)
  isPublished       Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([categoryId])
  @@index([designType, categoryId])
  @@index([isFeatured, isPublished])
  @@index([cloudinaryEtag])
}

model Event {
  id                 String       @id @default(cuid())
  title              String
  slug               String       @unique
  coverImageUrl      String
  coverImagePublicId String?
  isPublished        Boolean      @default(true)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  media              EventMedia[]
}

model EventMedia {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mediaUrl      String
  mediaPublicId String?
  mediaType     MediaType
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([eventId])
}

model HomeGalleryImage {
  id           String    @id @default(cuid())
  title        String
  altText      String?
  url          String
  cloudinaryId String?
  sortOrder    Int       @default(0)
  isPublished  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished, sortOrder])
}

// ==========================================
// RERA SUB-SITE ENUMS & MODELS
// ==========================================

enum ReraListingType {
  SALE
  RENT
}

enum ReraPropertyType {
  APARTMENT
  VILLA
  COMMERCIAL
  PLOT
  OTHER
}

enum ReraInterest {
  BUY
  SELL
  RENT
  OTHER
}

enum ReraGalleryCategory {
  RESIDENTIAL
  COMMERCIAL
  ONGOING
  HANDOVER
  OTHER
}

enum ReraEnquirySource {
  CONTACT_FORM
  CALLBACK
  PROPERTY_ENQUIRY
  POST_PROPERTY
  SITE_VISIT
}

// Singleton row (id = "singleton"), same pattern as SiteSettings
model ReraSettings {
  id                   String   @id @default("singleton")
  brokerName           String   @default("")
  tagline              String?
  reraRegistrationNo   String?  // shown publicly ONLY when non-empty
  reraRegisteredName   String?
  reraVerifyUrl        String?
  phone                String?
  altPhone             String?
  whatsapp             String?
  email                String?
  address              String?  @db.Text
  officeHours          String?
  socialLinks          Json?    // { instagram, facebook, youtube, linkedin }
  heroHeadline         String   @default("Find Your Dream Home in Thane")
  heroSubhead          String?  @db.Text
  heroImageUrl         String?
  heroImagePublicId    String?
  heroSlidesJson       String?  @db.Text
  heroSlideInterval    Int      @default(8)
  bhk1ImageUrl         String?
  bhk1ImagePublicId    String?
  bhk1Type             String   @default("1 BHK")
  bhk1Price            String?
  bhk2ImageUrl         String?
  bhk2ImagePublicId    String?
  bhk2Type             String   @default("2 BHK")
  bhk2Price            String?
  bhk3ImageUrl         String?
  bhk3ImagePublicId    String?
  bhk3Type             String   @default("3 BHK")
  bhk3Price            String?
  welcomeTitle         String?
  welcomeBody          String?  @db.Text
  aboutTitle           String?
  aboutBody            String?  @db.Text
  founderName          String?
  founderRole          String?
  founderImageUrl      String?
  founderImagePublicId String?
  yearsExperience      Int?
  happyFamilies        Int?
  propertiesClosed     Int?
  areasServed          String[] @default([])
  updatedAt            DateTime @updatedAt
}

model ReraService {
  id                   String   @id @default(cuid())
  title                String
  description          String   @db.Text
  iconKey              String?  // maps to a predefined icon set
  highlights           String[] @default([])
  sortOrder            Int      @default(0)
  isPublished          Boolean  @default(true)
  slug                 String?  @unique
  shortDescription     String?
  pageHeading          String?
  bannerImageUrl       String?
  bannerImagePublicId  String?
  bannerImageAlt       String?
  contentImages        Json?
  sections             Json?
  ctaText              String?
  ctaUrl               String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// "Popular Configurations" cards, e.g. 2 BHK starting from ...
model ReraConfiguration {
  id                 String   @id @default(cuid())
  label              String   // "2 BHK"
  startingPriceLabel String   // "Starting from 67 Lakh"
  carpetAreaLabel    String?  // "Carpet 650 sq ft"
  imageUrl           String?
  imagePublicId      String?
  sortOrder          Int      @default(0)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ReraProperty {
  id                 String              @id @default(cuid())
  title              String
  slug               String              @unique
  listingType        ReraListingType     @default(SALE)
  propertyType       ReraPropertyType    @default(APARTMENT)
  bhkLabel           String?             // "2 BHK"
  priceAmount        Int?                // rupees, used only for sorting and budget filters; priceLabel stays the display text
  carpetAreaSqFt     Int?
  builtUpAreaSqFt    Int?
  furnishing         String?             // e.g. "Semi-furnished"
  amenities          String[]            @default([])
  specifications     Json?               // [{ "label": "Flooring", "value": "Vitrified" }, ...]
  isNewLaunch        Boolean             @default(false) // builder project launches (replaces the standalone projects.ts)
  priceLabel         String              // display text, e.g. "67 Lakh" or "25,000 / month"
  locality           String
  city               String              @default("Thane")
  projectName        String?
  builderName        String?
  projectReraNo      String?             // shown on the card when present
  possession         String?
  description        String?             @db.Text
  coverImageUrl      String?
  coverImagePublicId String?
  isFeatured         Boolean             @default(false)
  isPublished        Boolean             @default(true)
  sortOrder          Int                 @default(0)
  images             ReraPropertyImage[]
  enquiries          ReraEnquiry[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([isPublished, isFeatured])
  @@index([listingType, propertyType])
  @@index([isNewLaunch, isPublished])
}

model ReraPropertyImage {
  id         String       @id @default(cuid())
  property   ReraProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  url        String
  publicId   String?
  mediaType  MediaType    @default(IMAGE)
  altText    String
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([propertyId])
}

model ReraBuilderPartner {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String
  logoPublicId String?
  websiteUrl   String?
  sortOrder    Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model ReraGalleryItem {
  id                String              @id @default(cuid())
  title             String
  category          ReraGalleryCategory @default(RESIDENTIAL)
  mediaType         MediaType           @default(IMAGE)
  url               String
  publicId          String?
  thumbnailUrl      String?             // poster for videos
  thumbnailPublicId String?
  fileSizeBytes     Int?
  cloudinaryEtag    String?             // duplicate detection, same idea as GalleryImage
  sortOrder         Int                 @default(0)
  isPublished       Boolean             @default(true)
  createdAt         DateTime            @default(now())

  @@index([category, isPublished])
}

model ReraEnquiry {
  id           String            @id @default(cuid())
  name         String
  phone        String
  email        String?
  interestedIn ReraInterest      @default(BUY)
  budgetLabel  String?
  locality     String?
  message      String?           @db.Text
  source       ReraEnquirySource @default(CONTACT_FORM)
  property     ReraProperty?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyId   String?
  status       LeadStatus        @default(NEW)
  notes        String?           @db.Text
  details      Json?             // form-specific fields: post-property type/BHK/area/expected price, preferred visit slot, etc.
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ReraTestimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String?
  society     String?
  quote       String   @db.Text
  rating      Int      @default(5)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model ReraFaq {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Only populated with branches the client confirms are real
model ReraBranch {
  id          String   @id @default(cuid())
  name        String
  address     String   @db.Text
  phone       String?
  mapUrl      String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}


